{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meetspace",
  "mainBinaryName": "meetspace",
  "identifier": "com.meetspace.stable",
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["meetspace"] }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://desktop2.meetspace.com/update/{{target}}-{{arch}}/{{current_version}}?channel=stable"
      ]
    }
  }
}
